# Copia questo file in .env (è ignorato da git) e compila i valori.
# Il core carica .env in ambiente senza interpretarlo: le variabili servono
# solo ai provider che le richiedono.

# ----------------------------------------------------------------------------
# Web app (docker-compose / run_dev.py)
# ----------------------------------------------------------------------------
HTTP_PORT=8080
MAX_DOWNLOAD_SIZE_MB=500
FILE_TTL_HOURS=24
JOB_TIMEOUT_SECONDS=1800
CLEANUP_INTERVAL_SECONDS=3600
BLOCK_PRIVATE_HOSTS=1

# ----------------------------------------------------------------------------
# Spotify (unico provider che usa credenziali) - modalità metadati via API Web
# ----------------------------------------------------------------------------
# Come ottenerle:
#   1. Vai su https://developer.spotify.com/dashboard e accedi con il tuo account.
#   2. "Create app": nome e descrizione a piacere, Redirect URI = il valore di
#      SPOTIFY_REDIRECT_URI qui sotto (deve coincidere esattamente),
#      API = "Web API". Salva.
#   3. Apri l'app -> "Settings": copia Client ID e Client secret.
# Le credenziali servono solo a leggere metadati pubblici (tracce, album,
# playlist); non danno accesso all'audio.
# ATTENZIONE: l'account con cui crei l'app deve avere Spotify Premium, altrimenti
# la Web API risponde 403 "Active premium subscription required for the owner
# of the app" a ogni richiesta (dopo l'attivazione possono servire alcune ore).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Deve essere identico a quello registrato nella dashboard. Per un'app locale
# va bene un loopback con porta esplicita:
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
